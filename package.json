{
  "name": "dsh-cloudflare",
  "version": "2.1.0",
  "type": "module",
  "description": "Connect multiple Cloudflare accounts to DeepSeek Harness and manage DNS, domains, Workers, R2, and more through Cloudflare's official MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LastDreamTeam/dsh-cloudflare.git"
  },
  "homepage": "https://github.com/LastDreamTeam/dsh-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/LastDreamTeam/dsh-cloudflare/issues"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/*.mjs",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cloudflare",
    "mcp",
    "oauth"
  ]
}
